# DraftCourt environment variables.
# Copy to .env.local (web) — this file documents NAMES ONLY. Never commit real secrets.
# See docs/adr/0004-local-dev-and-deployment-foundations.md for how each value is sourced
# locally vs. in preview/production.

# ---- shared / web (apps/web) ----------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Local Docker Compose Postgres — host port 55432 by default to avoid
# clashing with a native/Homebrew Postgres on 5432/5433 (see
# POSTGRES_HOST_PORT in docker-compose.yml). In preview/production this
# becomes a pooled Neon connection string; DIRECT_DATABASE_URL is the
# unpooled migration URL.
DATABASE_URL=postgresql://draftcourt:draftcourt@localhost:55432/draftcourt
DIRECT_DATABASE_URL=postgresql://draftcourt:draftcourt@localhost:55432/draftcourt

# Clerk (https://clerk.com) — leave blank locally to keep auth routes disabled;
# Phase 0 ships the scaffolding only, no real keys.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Upstash Redis in deployed environments. Locally this points at the Compose
# Redis container instead (plain redis:// URL, not the Upstash REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://localhost:6379

ANALYTICS_BASE_URL=http://localhost:8000
ANALYTICS_SERVICE_SECRET=local-dev-analytics-secret-change-me

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development

# Premium/AI stays disabled until the billing prerequisite ships (Phase 5).
OPENAI_API_KEY=
AI_ASSISTANT_ENABLED=false

PUBLIC_DEMO_ENABLED=true

# ---- analytics (services/analytics) ----------------------------------------
APP_ENV=development
# DATABASE_URL and SENTRY_DSN are shared with the block above.
SERVICE_SECRET=local-dev-analytics-secret-change-me
# Internal /internal/v1/* auth: request-timestamp replay window (seconds of
# allowed clock skew between web and analytics) and per-job wall-clock cap.
SERVICE_AUTH_TIMESTAMP_WINDOW_SECONDS=300
INTERNAL_JOB_TIMEOUT_SECONDS=900
MODEL_ARTIFACT_BUCKET=
MODEL_ARTIFACT_ACCESS_KEY=
MODEL_ARTIFACT_SECRET_KEY=
NBA_SOURCE_BASE_URL=
INJURY_SOURCE_BASE_URL=
